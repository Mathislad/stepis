# ============================================================================
# F5L — variables d'environnement (copier vers `.env.local` puis remplir)
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# Projet > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SERVEUR UNIQUEMENT — ne JAMAIS préfixer NEXT_PUBLIC_, ne jamais exposer.
# Utilisée par lib/supabase/admin.ts (opérations privilégiées contrôlées).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=change-me

# ── Brevo (SMS + email) — notifications de leads et fidélisation ───────────
# Si BREVO_API_KEY est vide, les workflows métier restent utilisables ; les
# notifications sont simplement ignorées ou journalisées selon le module.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@stepis.fr
BREVO_SENDER_NAME=F5L
BREVO_SMS_SENDER=F5L

# ── Anthropic (agents IA) — préparé pour Manager / Acquisition ──────────────
ANTHROPIC_API_KEY=
# Modèle Anthropic explicitement choisi côté déploiement.
ANTHROPIC_MODEL=
