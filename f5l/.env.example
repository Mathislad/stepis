# ============================================================================
# F5L — variables d'environnement (copier vers `.env.local` puis remplir)
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# Projet > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SERVEUR UNIQUEMENT — ne JAMAIS préfixer NEXT_PUBLIC_, ne jamais exposer.
# Utilisée par lib/supabase/admin.ts (opérations privilégiées contrôlées).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Brevo (SMS + email) — notifications de leads (Étape 3) ──────────────────
# Si BREVO_API_KEY est vide, la capture de lead fonctionne quand même (les
# notifications sont simplement ignorées, cf. lib/brevo/notify.ts).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@stepis.fr
BREVO_SENDER_NAME=F5L
BREVO_SMS_SENDER=F5L

# ── Anthropic (agents IA) — PRÉPARÉ, non utilisé à l'Étape 1 ─────────────────
ANTHROPIC_API_KEY=
