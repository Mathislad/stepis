# ============================================================================
# F5L — variables d'environnement (copier vers `.env.local` puis remplir)
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# Projet > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SERVEUR UNIQUEMENT — ne JAMAIS préfixer NEXT_PUBLIC_, ne jamais exposer.
# Utilisée par lib/supabase/admin.ts (opérations privilégiées contrôlées).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=change-me

# ── Brevo (SMS + email) — notifications de leads et fidélisation ───────────
# Si BREVO_API_KEY est vide, les workflows métier restent utilisables ; les
# notifications sont simplement ignorées ou journalisées selon le module.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@stepis.fr
BREVO_SENDER_NAME=F5L
BREVO_SMS_SENDER=F5L

# ── Anthropic (agents IA) — préparé pour Manager / Acquisition ──────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── Stripe (facturation) — stub gracieux tant que la clé manque ────────────
# Sans STRIPE_SECRET_KEY, les changements de formule sont appliqués en mode
# « démo » côté Supabase (utile en dev). À brancher pour la facturation réelle.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_FULL=

# ── Vapi (téléphonie IA) — stub ─────────────────────────────────────────────
VAPI_API_KEY=

# ── Meta Ads / Google Ads — stubs ──────────────────────────────────────────
META_ADS_TOKEN=
GOOGLE_ADS_TOKEN=

# ── Yousign / Pennylane — stubs ────────────────────────────────────────────
YOUSIGN_API_KEY=
PENNYLANE_API_KEY=
